    {"id": "employer",         "name": "Employer",                  "primary_threat": "Professional reputation, work-related content",  "cost_to_defend": "medium"},
    {"id": "civil_discovery",  "name": "Civil discovery",            "primary_threat": "Legal exposure from content or associations",    "cost_to_defend": "medium"},
    {"id": "corporations",     "name": "Corporations",               "primary_threat": "ToS exploitation, data monetization",            "cost_to_defend": "low"},
    {"id": "state_actor",      "name": "State actor",                "primary_threat": "Surveillance, targeting",                        "cost_to_defend": "high", "out_of_scope": true},
    {"id": "autonomous_ai_agent", "name": "Autonomous adversarial agentic AI", "primary_threat": "Automated, machine-scale cross-compartment correlation, aggregation, and stylometric fingerprinting of public content", "cost_to_defend": "high"}
